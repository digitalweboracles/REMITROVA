APP_NAME=RemitRova
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=remitrova
DB_USERNAME=remitrova
DB_PASSWORD=

QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
CACHE_STORE=redis

# ---------------------------------------------------------------
# Paga — Collect API (Static/Persistent NUBAN)
# Sandbox base URL confirmed working: https://beta-collect.paga.com
# Get PAGA_PRINCIPAL / PAGA_SECRET_KEY / PAGA_HASH_KEY from Paga's
# merchant dashboard (sandbox credentials first, production later).
# ---------------------------------------------------------------
PAGA_COLLECT_BASE_URL=https://beta-collect.paga.com
PAGA_PRINCIPAL=
PAGA_SECRET_KEY=
PAGA_HASH_KEY=

# ---------------------------------------------------------------
# Paga — Business API (Disbursement) — Phase 2, included here so the
# env structure is ready when disbursement work starts.
# Sandbox base URL CONFIRMED BY PAGA SUPPORT (not the base URL shown
# in some of their own doc code samples, which are illustrative only):
#   https://beta.mypaga.com/paga-webservices/business-rest/secured
# ---------------------------------------------------------------
PAGA_BUSINESS_BASE_URL=https://beta.mypaga.com/paga-webservices/business-rest/secured
